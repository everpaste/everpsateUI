--                    "Bottom Right" / "Bottom Center" / "Bottom Left"
--   show           — какие пункты показывать (logo, name, ping, user=аватар,
--                    speed, time, fps, ram, kd, gpu, cpu, cpufreq, latency,
--                    loss, issues, server, preset)
--   order          — порядок пунктов (в игре можно перетаскивать мышью)
Win:SetWatermark({
    positionPreset = "Top Right",
    show = { logo = true, name = true, ping = true, user = true, speed = false, time = false, fps = false, ram = false },
    order = { "logo", "name", "ping", "user", "speed", "time", "fps", "ram" },
})

