--[[
    Neverlose UI для Roblox — демо-скрипт.

    Этот файл показывает ВСЁ, что умеет библиотека: окно, вкладки, подвкладки,
    секции, все виды элементов, плашки «...» с доп. настройками, аккордеоны,
    подсказки, бинды, вотермарку, превью игроков (Players) и экран снаряжения
    (Inventory). Скопируй нужные куски в свой скрипт.

    Порядок работы:
      1. Загрузить библиотеку (блок «ЗАГРУЗКА» ниже).
      2. Library:AddWindow(...) — создать окно.
      3. Win:AddTab(...) / Tab:AddSubTab(...) — вкладки.
      4. Tab:AddSection(...) — секции (карточки) в левой или правой колонке.
      5. Section:AddToggle / AddSlider / AddDropdown ... — элементы.
      Каждый элемент вызывает свой callback при изменении и умеет :Set() / :Get().

    Управление в игре:
      RShift              — открыть / закрыть меню.
      Колесико или ПКМ    — на любой функции: меню хоткеев (All Hotkeys / New Hotkey / Reset).
      ПКМ по вотермарке   — настройки вотермарки (Items, цвет, аватар, позиция).
      ЛКМ + тянуть        — вотермарку, Hotkeys и Spectators можно двигать (пока меню открыто).
      Иконка дискеты      — сохранить текущий пресет (конфиг).
]]

-- =========================================================================
-- ЗАГРУЗКА
-- =========================================================================
-- Библиотека — один файл scr.lua. Здесь он скачивается с GitHub. Перед
-- loadstring из исходника вырезаются комментарии и отступы: очень большой
-- исходник некоторые экзекуторы отказываются компилировать.

local LIBRARY_FILE = "scr.lua"
local LIBRARY_URL = "https://raw.githubusercontent.com/whotner/nl-menu-rb/main/scr.lua"

local function stripComments(src)
    local out, i, n = {}, 1, #src
    while i <= n do
        local c = src:sub(i, i)
        local two = src:sub(i, i + 1)
        if two == "--" then
            -- длинный комментарий --[[ ... ]] / --[=[ ... ]=]
            local eq = src:match("^%-%-%[(=*)%[", i)
            if eq then
                local close = "]" .. eq .. "]"
                local stop = src:find(close, i, true)
                i = stop and (stop + #close) or (n + 1)
            else
                local nl = src:find("\n", i, true)
                i = nl or (n + 1)
            end
        elseif c == '"' or c == "'" then
            -- строки копируются как есть
            local quote = c
            local start = i
            i = i + 1
            while i <= n do
                local ch = src:sub(i, i)
                if ch == "\\" then
                    i = i + 2
                elseif ch == quote then
                    i = i + 1
                    break
                elseif ch == "\n" then
                    break
                else
                    i = i + 1
                end
            end
            out[#out + 1] = src:sub(start, i - 1)
        elseif c == "[" then
            -- длинные строки [[...]], [=[...]=] — тоже как есть
            local eq = src:match("^%[(=*)%[", i)
            if eq then
                local closeToken = "]" .. eq .. "]"
                local contentStart = i + #eq + 2
                local closeStart = src:find(closeToken, contentStart, true)
                local stop = closeStart and (closeStart + #closeToken - 1) or n
                out[#out + 1] = src:sub(i, stop)
                i = stop + 1
            else
                local nl = src:find("\n", i, true)
                local stop = nl and (nl - 1) or n
                local line = src:sub(i, stop)
                local trimmed = line:match("^[ \t]*(.-)[ \t]*$")
                if trimmed ~= "" then out[#out + 1] = trimmed end
                if nl then
                    out[#out + 1] = "\n"
                    i = nl + 1
                else
                    i = n + 1
                end
            end
        else
            local nl = src:find("\n", i, true)
            local stop = nl and (nl - 1) or n
            local line = src:sub(i, stop)
            local trimmed = line:match("^[ \t]*(.-)[ \t]*$")
            if trimmed ~= "" then out[#out + 1] = trimmed end
            if nl then
                out[#out + 1] = "\n"
                i = nl + 1
            else
                i = n + 1
            end
        end
    end
    return table.concat(out)
end

local function loadLibrary(src, origin)
    local fn, err = loadstring(stripComments(src), origin)
    if not fn then error(origin .. ": compile failed: " .. tostring(err)) end
    local lib = fn()
    if type(lib) ~= "table" or type(lib.AddWindow) ~= "function" then
        error(origin .. ": did not return the library")
    end
    return lib
end

-- true = брать scr.lua из папки workspace экзекутора, а не с GitHub
-- (удобно, если правишь библиотеку сам).
local USE_LOCAL_FILE = false

-- GitHub кэширует ссылку на "main" несколько минут. Поэтому сначала узнаём
-- хэш последнего коммита и качаем файл по нему — всегда самая свежая версия.
local function latestLibraryUrl()
    local ok, body = pcall(function()
        return game:HttpGet("https://api.github.com/repos/whotner/nl-menu-rb/commits/main")
    end)
    local sha = ok and type(body) == "string" and body:match('"sha"%s*:%s*"(%x+)"')
    if sha then
        return "https://raw.githubusercontent.com/whotner/nl-menu-rb/" .. sha .. "/scr.lua"
    end
    return LIBRARY_URL .. "?v=" .. tostring(os.time())
end

local Library
if USE_LOCAL_FILE and type(readfile) == "function" and type(isfile) == "function" and isfile(LIBRARY_FILE) then
    Library = loadLibrary(readfile(LIBRARY_FILE), LIBRARY_FILE)
else
    local url = latestLibraryUrl()
    print("[nl-menu] loading " .. url)
    Library = loadLibrary(game:HttpGet(url), url)
end

